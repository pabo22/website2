# ---------------------------------------------------------------------------
# Diese Datei nach ".env" kopieren und mit echten Werten füllen.
#   macOS/Linux:  cp .env.example .env
#   Windows CMD:  copy .env.example .env
# Die .env selbst gehört NIE ins Git-Repository (steht in .gitignore).
# ---------------------------------------------------------------------------

# PFLICHT ────────────────────────────────────────────────────────────────────

# PostgreSQL-Datenbank (z. B. kostenlos bei Neon oder Supabase).
# Der Wert unten ist NUR EIN MUSTER und funktioniert nicht. Er muss komplett
# durch den Connection String des eigenen Anbieters ersetzt werden - alles in
# einer Zeile, in Anführungszeichen, ohne Zeilenumbruch.
# Bei Neon steht er im Projekt-Dashboard unter "Connection string".
DATABASE_URL="postgresql://BENUTZER:PASSWORT@HOST:5432/DATENBANK?sslmode=require"

# Signiert die Anmelde-Sessions. Erzeugen mit:  openssl rand -base64 32
NEXTAUTH_SECRET="hier-einen-langen-zufaelligen-string-einfuegen"

# Lokal http://localhost:3000, in Produktion die echte Domain mit https://
NEXTAUTH_URL="http://localhost:3000"

# Passwort für den internen Bereich unter /admin.
# Nach der Übergabe an den Betrieb unbedingt ändern.
ADMIN_PASSWORD="hier-ein-sicheres-passwort-einfuegen"

# E-Mail-Versand (Anfrage-Benachrichtigung + Eingangsbestätigung)
SMTP_HOST="smtp.beispielanbieter.de"
SMTP_PORT="587"
SMTP_USER="postfach@beispielanbieter.de"
SMTP_PASSWORD="hier-passwort-einfuegen"

# OPTIONAL ───────────────────────────────────────────────────────────────────

# Volle Adresse der Live-Seite. Wird für korrekte Vorschaubilder beim Teilen
# in WhatsApp, Facebook & Co. gebraucht.
NEXT_PUBLIC_SITE_URL="https://www.is-bau-beispiel.de"

# Foto-Upload im Anfrageformular (Vercel Blob).
# BEIDE Variablen setzen, sonst bleibt der Upload-Bereich ausgeblendet und
# das Formular funktioniert normal weiter - ohne Fotos.
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_FOTO_UPLOAD_AKTIV="false"

# Monatsbericht per E-Mail (Zeitplan in vercel.json, jeden 1. um 06:00 UTC).
# Ohne diesen Wert ist der Bericht deaktiviert - die Route antwortet dann mit
# 501 und lässt sich von außen nicht auslösen.
# Erzeugen wie NEXTAUTH_SECRET, z. B.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""
